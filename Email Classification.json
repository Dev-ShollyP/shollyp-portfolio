      "parameters": {
        "jsCode": "const subject = $input.first().json.subject || $input.first().json.Subject || '';\nconst s = subject.toLowerCase();\n\nlet department = 'Other';\n\nif (s.includes('quote') || s.includes('pricing') || s.includes('deal') || s.includes('proposal')) {\n  department = 'Sales';\n} else if (s.includes('support') || s.includes('issue') || s.includes('refund') || s.includes('complaint')) {\n  department = 'Customer Service';\n} else if (s.includes('leave') || s.includes('payroll') || s.includes('hiring') || s.includes('onboarding')) {\n  department = 'HR';\n} else if (s.includes('invoice') || s.includes('payment') || s.includes('budget') || s.includes('expense')) {\n  department = 'Finance';\n} else if (s.includes('delivery') || s.includes('logistics') || s.includes('supply') || s.includes('maintenance')) {\n  department = 'Operations';\n}\n\nreturn [{ json: { ...$input.first().json, department } }];"
      },
