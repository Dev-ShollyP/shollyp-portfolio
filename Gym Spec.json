r-spacing:1px;\">MEMBER NAME</p>\n                    <p style=\"margin:0;font-size:15px;font-weight:bold;color:#ffffff;\">{{ $('Search records').item.json.fields['Full Name'] }}</p>\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding:16px 20px;border-bottom:1px solid #2e2e2e;\">\n                    <p style=\"margin:0 0 4px;font-size:11px;color:#888888;letter-spacing:1px;\">EMAIL</p>\n                    <p style=\"margin:0;font-size:15px;font-weight:bold;color:#FF4500;\">{{ $('Search records').item.json.fields['Email Address'] }}</p>\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding:16px 20px;border-bottom:1px solid #2e2e2e;\">\n                    <p style=\"margin:0 0 4px;font-size:11px;color:#888888;letter-spacing:1px;\">PHONE</p>\n                    <p style=\"margin:0;font-size:15px;font-weight:bold;color:#ffffff;\">{{ $('Search records').item.json.fields['Phone Number'] }}</p>\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding:16px 20px;border-bottom:1px solid #2e2e2e;\">\n                    <p style=\"margin:0 0 4px;font-size:11px;color:#888888;letter-spacing:1px;\">PLAN</p>\n                    <p style=\"margin:0;font-size:15px;font-weight:bold;color:#ffffff;\">{{ $('Search records').item.json.fields.Subscription }}</p>\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding:16px 20px;\">\n                    <p style=\"margin:0 0 4px;font-size:11px;color:#888888;letter-spacing:1px;\">EXPIRY DATE</p>\n                    <p style=\"margin:0;font-size:15px;font-weight:bold;color:#FFD700;\">{{ $('Search records').item.json.fields['End Date'] }}</p>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Action required block -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom:28px;\">\n                <tr>\n                  <td style=\"background-color:#1f1a00;border-radius:8px;border-left:4px solid #FFD700;padding:20px 24px;\">\n                    <p style=\"margin:0 0 6px;font-size:11px;font-weight:bold;letter-spacing:2px;color:#FFD700;\">ACTION REQUIRED</p>\n                    <p style=\"margin:0;font-size:14px;color:#cccccc;line-height:1.8;\">Reach out to this member via phone or email. Confirm if they received the renewal reminder and assist them with the renewal process if needed.</p>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Footer -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                <tr>\n                  <td style=\"border-top:1px solid #2e2e2e;padding-top:20px;text-align:center;\">\n                    <p style=\"margin:0;font-size:12px;color:#555555;line-height:1.7;\">This is an automated internal alert from your n8n workflow.<br>© 2026 Gym Spec. All rights reserved.</p>\n                  </td>\n                </tr>\n              </table>\n\n            </td>\n          </tr>\n\n        </table>\n      </td>\n    </tr>\n  </table>\n\n</body>\n</html>",
