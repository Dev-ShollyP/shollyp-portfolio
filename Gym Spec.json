    {
      "parameters": {
        "sendTo": "={{ $('Tally Trigger').item.json.question_4jpN7b.value }}",
        "subject": "Welcome to Gym Spec ",
        "message": "=<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n</head>\n<body style=\"margin:0;padding:0;background-color:#111111;font-family:Arial,sans-serif;\">\n\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#111111;padding:32px 16px;\">\n    <tr>\n      <td align=\"center\">\n        <table width=\"560\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-radius:12px;overflow:hidden;\">\n\n          <!-- Header -->\n          <tr>\n            <td style=\"background-color:#FF4500;padding:36px 32px 28px;\">\n              <p style=\"margin:0 0 12px;font-size:11px;font-weight:bold;letter-spacing:3px;color:#ffcfb8;\">MEMBERSHIP CONFIRMED</p>\n              <p style=\"margin:0;font-size:32px;font-weight:900;color:#ffffff;line-height:1.1;\">YOU'RE IN.<br>LET'S GET TO WORK.</p>\n              <div style=\"margin-top:16px;width:48px;height:4px;background:#ffffff;border-radius:2px;\"></div>\n            </td>\n          </tr>\n\n          <!-- Gradient stripe -->\n          <tr>\n            <td style=\"background:linear-gradient(90deg,#FF4500,#FF8C00,#FFD700);height:6px;font-size:0;line-height:0;\">&nbsp;</td>\n          </tr>\n\n          <!-- Body -->\n          <tr>\n            <td style=\"background-color:#1a1a1a;padding:32px;\">\n\n              <p style=\"margin:0 0 6px;font-size:16px;color:#ffffff;font-weight:bold;\">Hey {{ $json.fields['Full Name'] }},</p>\n              <p style=\"margin:0 0 28px;font-size:14px;color:#aaaaaa;line-height:1.8;\">Your membership is locked in and ready to go. No excuses — the gym is waiting for you. Here's everything you need to know.</p>\n\n              <!-- Stats row -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom:28px;\">\n                <tr>\n                  <td width=\"33%\" style=\"padding-right:6px;\">\n                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#222222;border-radius:8px;border-left:3px solid #FF4500;\">\n                      <tr>\n                        <td style=\"padding:16px;\">\n                          <p style=\"margin:0 0 6px;font-size:11px;color:#888888;letter-spacing:1px;\">PLAN</p>\n                          <p style=\"margin:0;font-size:15px;font-weight:bold;color:#ffffff;\">{{ $('Tally Trigger').item.json.question_2rDxAp.value }}</p>\n                        </td>\n                      </tr>\n                    </table>\n                  </td>\n                  <td width=\"33%\" style=\"padding-right:6px;\">\n                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#222222;border-radius:8px;border-left:3px solid #FF8C00;\">\n                      <tr>\n                        <td style=\"padding:16px;\">\n                          <p style=\"margin:0 0 6px;font-size:11px;color:#888888;letter-spacing:1px;\">STARTS</p>\n                          <p style=\"margin:0;font-size:15px;font-weight:bold;color:#ffffff;\">{{ $('Create a record').item.json.fields['Start Date'] }}</p>\n                        </td>\n                      </tr>\n                    </table>\n                  </td>\n                  <td width=\"33%\">\n                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#222222;border-radius:8px;border-left:3px solid #FFD700;\">\n                      <tr>\n                        <td style=\"padding:16px;\">\n                          <p style=\"margin:0 0 6px;font-size:11px;color:#888888;letter-spacing:1px;\">EXPIRES</p>\n                          <p style=\"margin:0;font-size:15px;font-weight:bold;color:#ffffff;\">{{ $('Create a record').item.json.fields['End Date'] }}</p>\n                        </td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Divider -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom:28px;\">\n                <tr><td style=\"border-top:1px solid #2e2e2e;font-size:0;\">&nbsp;</td></tr>\n              </table>\n\n              <!-- What's next -->\n               <p style=\"margin:0 0 16px;font-size:11px;font-weight:bold;letter-spacing:2px;color:#FF4500;\">WHAT'S NEXT</p>\n\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom:14px;\">\n                <tr>\n                  <td width=\"36\" valign=\"top\">\n                    <div style=\"width:28px;height:28px;background:#FF4500;border-radius:50%;text-align:center;line-height:28px;font-size:12px;font-weight:bold;color:#ffffff;\">1</div>\n                  </td>\n                  <td style=\"padding-left:8px;font-size:14px;color:#cccccc;line-height:1.6;\">Show your membership confirmation at the front desk on your first visit.</td>\n                </tr>\n              </table>\n\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom:14px;\">\n                <tr>\n                  <td width=\"36\" valign=\"top\">\n                    <div style=\"width:28px;height:28px;background:#FF8C00;border-radius:50%;text-align:center;line-height:28px;font-size:12px;font-weight:bold;color:#ffffff;\">2</div>\n                  </td>\n                  <td style=\"padding-left:8px;font-size:14px;color:#cccccc;line-height:1.6;\">Pick your training days and stick to the plan.</td>\n                </tr>\n              </table>\n\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom:28px;\">\n                <tr>\n                  <td width=\"36\" valign=\"top\">\n                    <div style=\"width:28px;height:28px;background:#FFD700;border-radius:50%;text-align:center;line-height:28px;font-size:12px;font-weight:bold;color:#111111;\">3</div>\n                  </td>\n                  <td style=\"padding-left:8px;font-size:14px;color:#cccccc;line-height:1.6;\">Push hard. Results come to those who show up.</td>\n                </tr>\n              </table>\n\n              <!-- CTA -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom:28px;\">\n                <tr>\n                  <td align=\"center\">\n                    <a href=\"#\" style=\"display:inline-block;background-color:#FF4500;color:#ffffff;font-size:14px;font-weight:900;padding:14px 36px;border-radius:6px;text-decoration:none;letter-spacing:1px;\">START TRAINING NOW</a>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Footer -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                <tr>\n                  <td style=\"border-top:1px solid #2e2e2e;padding-top:20px;text-align:center;\">\n                    <p style=\"margin:0;font-size:12px;color:#555555;line-height:1.7;\">Questions? Reply to this email anytime.<br>© 2026 Gym Spec. All rights reserved.</p>\n                  </td>\n                </tr>\n              </table>\n\n            </td>\n          </tr>\n\n        </table>\n      </td>\n    </tr>\n  </table>\n\n</body>\n</html>",
