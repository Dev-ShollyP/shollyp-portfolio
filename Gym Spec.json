ellspacing=\"0\" style=\"margin-bottom:28px;\">                 <tr><td style=\"border-top:1px solid #2e2e2e;font-size:0;\">&nbsp;</td></tr>               </table>                <!-- Motivation block -->               <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom:28px;\">                 <tr>                   <td style=\"background-color:#222222;border-radius:8px;border-left:4px solid #FF4500;padding:20px 24px;\">                     <p style=\"margin:0 0 8px;font-size:11px;font-weight:bold;letter-spacing:2px;color:#FF4500;\">KEEP THE MOMENTUM</p>                     <p style=\"margin:0;font-size:14px;color:#cccccc;line-height:1.8;\">Consistency beats intensity every time. You showed up again — that's what separates those who talk from those who transform. The gym is ready when you are.</p>                   </td>                 </tr>               </table>                <!-- What's updated -->               <p style=\"margin:0 0 16px;font-size:11px;font-weight:bold;letter-spacing:2px;color:#FF4500;\">WHAT'S UPDATED</p>                <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom:14px;\">                 <tr>                   <td width=\"36\" valign=\"top\">                     <div style=\"width:28px;height:28px;background:#FF4500;border-radius:50%;text-align:center;line-height:28px;font-size:12px;font-weight:bold;color:#ffffff;\">&#10003;</div>                   </td>                   <td style=\"padding-left:8px;font-size:14px;color:#cccccc;line-height:1.6;\">Membership status set to <strong style=\"color:#ffffff;\">Active</strong></td>                 </tr>               </table>                <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom:14px;\">                 <tr>                   <td width=\"36\" valign=\"top\">                     <div style=\"width:28px;height:28px;background:#FF8C00;border-radius:50%;text-align:center;line-height:28px;font-size:1